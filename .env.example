# Generated secrets: python3 scripts/setup.py --sandbox
COMPOSE_PROJECT_NAME=n8n-compose
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=,
COMPOSE_PROFILES=search

# Keep n8n and Code-node runners on the same release.
N8N_VERSION=2.36.9
POSTGRES_IMAGE=postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
SEARXNG_IMAGE=ghcr.io/searxng/searxng@sha256:ad273460b12390ab1ad9c6ea630dafed39045ab0b9096a85ca31f5246517c670
REDIS_IMAGE=redis:7.4-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
QDRANT_IMAGE=qdrant/qdrant:v1.19.2@sha256:b7b0444c4c351c970b98e90a6f89c2ee4287c65b44e52b4cb503fa5b2aa927ad
REDISINSIGHT_IMAGE=redis/redisinsight@sha256:b5e19ee240abef6edb435871b90ff8a210995422e8e018ab61c0339d318a1f84
SANDBOX_API_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-api@sha256:3ac19681cae36f3d1fb879cc572d3488088d03c45c4c96b6ff4f0bbdd2d00e7e
SANDBOX_RUNNER_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-runner-dind@sha256:b744471997bbaf1bf75b5ca667d0931352bdb4d59ecc7935ceab7e742829a117
SANDBOX_WORKLOAD_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-sandbox@sha256:b397f4b51c75faf83cdd9f7aaf8a415a96e6462478cd7694a2b795f664ba1233

GENERIC_TIMEZONE=Asia/Seoul
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
SEARXNG_SECRET=
REDIS_PASSWORD=
QDRANT_API_KEY=
SANDBOX_API_KEY=
SANDBOX_REGISTRATION_TOKEN=
SANDBOX_RUNNER_API_KEY=

# Local HTTP. See docs/OPERATIONS.md before using a public domain.
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false
SEARXNG_PORT=8888
QDRANT_PORT=6333
REDISINSIGHT_PORT=5540
EXECUTIONS_DATA_MAX_AGE=168

# Instance AI: set an OpenAI-compatible model endpoint/key to use the assistant.
N8N_INSTANCE_AI_MODEL=
N8N_INSTANCE_AI_MODEL_URL=
N8N_INSTANCE_AI_MODEL_API_KEY=

# Google OAuth: python3 scripts/setup.py --google-oauth /path/to/downloaded-client.json
# The converted .local/google-oauth.json is excluded from Git.
