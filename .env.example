# Create .env and private keys: python3 scripts/setup.py --sandbox
# Windows PowerShell: py -3 scripts/setup.py --sandbox
COMPOSE_PROJECT_NAME=n8n-compose
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=,
COMPOSE_PROFILES=search

# Track stable releases; one value controls n8n and Code-node runners.
# Set an exact release here only when you need to keep that version.
N8N_VERSION=stable
GENERIC_TIMEZONE=Asia/Seoul

# Local browser addresses. Change all three n8n entries if changing its port.
N8N_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
SEARXNG_PORT=8888

# Generated automatically. Preserve these values when updating.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
SEARXNG_SECRET=
REDIS_PASSWORD=
QDRANT_API_KEY=
SANDBOX_API_KEY=
SANDBOX_REGISTRATION_TOKEN=
SANDBOX_RUNNER_API_KEY=

# Instance AI: set an OpenAI-compatible model endpoint/key to use the assistant.
N8N_INSTANCE_AI_MODEL=
N8N_INSTANCE_AI_MODEL_URL=
N8N_INSTANCE_AI_MODEL_API_KEY=

# Google OAuth: python3 scripts/setup.py --google-oauth /path/to/downloaded-client.json
# The converted .local/google-oauth.json is excluded from Git.
# Image overrides, public URLs and other advanced options: docs/CONFIGURATION.md
